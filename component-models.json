  {
    "id": "carousel",
    "fields": [
      {
        "component": "select",
        "name": "classes_layout",
        "value": "slides-1",
        "label": "Slides visible at once (desktop)",
        "description": "Mobile always shows one slide. Tablet shows up to two.",
        "valueType": "string",
        "options": [
          {
            "name": "One",
            "value": "slides-1"
          },
          {
            "name": "Two",
            "value": "slides-2"
          },
          {
            "name": "Three",
            "value": "slides-3"
          }
        ]
      },
      {
        "component": "select",
        "name": "classes_style",
        "value": "split",
        "label": "Slide style",
        "valueType": "string",
        "options": [
          {
            "name": "Image beside text",
            "value": "split"
          },
          {
            "name": "Image above text (card)",
            "value": "stacked"
          },
          {
            "name": "Text over image",
            "value": "overlay"
          }
        ]
      },
      {
        "component": "select",
        "name": "classes_navigation",
        "value": "nav-arrows-dots",
        "label": "Navigation",
        "valueType": "string",
        "options": [
          {
            "name": "Arrows and dots",
            "value": "nav-arrows-dots"
          },
          {
            "name": "Arrows and thumbnails",
            "value": "nav-thumbnails"
          },
          {
            "name": "Arrows only",
            "value": "nav-arrows"
          },
          {
            "name": "Dots only",
            "value": "nav-dots"
          }
        ]
      },
      {
        "component": "boolean",
        "name": "classes_counter",
        "label": "Show slide counter (e.g. 3 / 10)",
        "valueType": "boolean"
      },
      {
        "component": "select",
        "name": "classes_autoplay",
        "value": "autoplay-off",
        "label": "Autoplay",
        "description": "Autoplay pauses on hover and focus, is disabled for users who prefer reduced motion and always includes a pause button.",
        "valueType": "string",
        "options": [
          {
            "name": "Off",
            "value": "autoplay-off"
          },
          {
            "name": "Every 4 seconds",
            "value": "autoplay-4"
          },
          {
            "name": "Every 6 seconds",
            "value": "autoplay-6"
          },
          {
            "name": "Every 10 seconds",
            "value": "autoplay-10"
          }
        ]
      },
      {
        "component": "boolean",
        "name": "classes_loop",
        "label": "Loop (go back to the first slide after the last one)",
        "valueType": "boolean"
      },
      {
        "component": "select",
        "name": "classes_transition",
        "value": "transition-slide",
        "label": "Transition",
        "description": "Fade only applies when one slide is visible at once.",
        "valueType": "string",
        "options": [
          {
            "name": "Slide",
            "value": "transition-slide"
          },
          {
            "name": "Fade",
            "value": "transition-fade"
          }
        ]
      },
      {
        "component": "select",
        "name": "classes_theme",
        "value": "theme-light",
        "label": "Color theme",
        "valueType": "string",
        "options": [
          {
            "name": "Light",
            "value": "theme-light"
          },
          {
            "name": "Dark",
            "value": "theme-dark"
