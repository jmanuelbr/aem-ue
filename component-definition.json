        {
          "title": "Adventure Content Fragment",
          "id": "adventure-cf",
          "plugins": {
            "xwalk": {
              "page": {
                "resourceType": "core/franklin/components/block/v1/block",
                "template": {
                  "name": "Adventure CF",
                  "model": "adventure-cf",
                  "filter": "cf"
                }
